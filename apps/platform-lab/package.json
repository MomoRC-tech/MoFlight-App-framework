{
  "name": "@moflight/platform-lab",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:offline": "expo run:android --variant release --no-bundler",
    "ios:offline": "expo run:ios --configuration Release --no-bundler",
    "bundle": "expo export --platform android --platform ios --output-dir dist",
    "prebuild:check": "expo prebuild --no-install --platform all"
  },
  "dependencies": {
    "@moflight/flight-logbook": "workspace:*",
    "@moflight/local-data": "workspace:*",
    "expo": "57.0.27",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-sqlite": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webview": "13.16.1"
  }
}
