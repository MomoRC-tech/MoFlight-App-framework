{
  "name": "moflight-workspace",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "vf:api": "node pocs/vereinsflieger-api-anything/tooling.mjs",
    "vf:login": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File pocs/vereinsflieger-api-anything/dpapi-login.ps1",
    "vf:study": "node --import tsx pocs/vereinsflieger-api-anything/study.mjs",
    "vf:configure": "node pocs/vereinsflieger-api-anything/tooling.mjs configure",
    "vf:verify": "pnpm --filter @moflight/api-anything-research run verify",
    "check": "python scripts/verify_host.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "android:build": "python scripts/android_build.py",
    "test:e2e": "python scripts/maestro_smoke.py",
    "ui:agent": "python scripts/ui_agent.py",
    "maestro:install": "python scripts/install_maestro.py",
    "test": "node --import tsx --test tests/mobile/*.test.ts",
    "lab": "pnpm --filter @moflight/platform-lab start",
    "bundle": "pnpm --filter @moflight/platform-lab bundle",
    "fixtures:check": "python3 scripts/mobile_fixtures.py --check"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
